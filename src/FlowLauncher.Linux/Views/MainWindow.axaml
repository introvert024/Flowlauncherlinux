<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FlowLauncher.Linux.ViewModels"
        x:Class="FlowLauncher.Linux.MainWindow"
        Title="Flow Launcher"
        Width="580"
        MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        CanResize="False">

    <Window.Styles>
        <Style Selector="TextBox.SearchBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ListBox.ResultsList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#220078D4" />
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Background blur panel -->
        <Panel>
            <ExperimentalAcrylicBorder IsHitTestVisible="False">
                <ExperimentalAcrylicBorder.Material>
                    <ExperimentalAcrylicMaterial
                        BackgroundSource="Digger"
                        TintColor="Black"
                        TintOpacity="0.7"
                        MaterialOpacity="0.85" />
                </ExperimentalAcrylicBorder.Material>
            </ExperimentalAcrylicBorder>
        </Panel>

        <Border CornerRadius="12" ClipToBounds="True">
            <StackPanel>
                <!-- Search Bar -->
                <Border Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Search Icon -->
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   VerticalAlignment="Center" Margin="12,0,4,0" Opacity="0.6" Foreground="White"/>
                        <!-- Query Input -->
                        <TextBox Grid.Column="1"
                                 Classes="SearchBox"
                                 Text="{Binding QueryText, Mode=TwoWay}"
                                 Watermark="Search..."
                                 KeyDown="OnQueryKeyDown" />
                        <!-- Clear button -->
                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                IsVisible="{Binding HasQuery}"
                                Command="{Binding ClearQueryCommand}"
                                Margin="4">
                            <TextBlock Text="✕" Foreground="White" Opacity="0.6" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Results -->
                <ListBox Classes="ResultsList"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult}"
                         IsVisible="{Binding HasResults}"
                         MaxHeight="360"
                         DoubleTapped="OnResultDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="52">
                                <!-- Icon -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4"
                                        Margin="4" VerticalAlignment="Center"
                                        ClipToBounds="True">
                                    <Image Source="{Binding IcoPath}" Stretch="UniformToFill" />
                                </Border>
                                <!-- Title & Subtitle -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                               Foreground="White" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SubTitle}" FontSize="11"
                                               Foreground="#AAFFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding SubTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Status Bar -->
                <Border IsVisible="{Binding HasResults}" Background="#0AFFFFFF" Padding="8,4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11"
                                   Foreground="#66FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="↵ Open  ⇧↵ Run  Esc Close" FontSize="11"
                                   Foreground="#44FFFFFF" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Panel>
</Window>
